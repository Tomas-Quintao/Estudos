programa {
 real ano,idade

  funcao inicio() {
    escreva("Rapaz escreva o ano de seu nascimento:")
    leia(ano)
    idade = 2025 - ano
    se (idade < 18){
      escreva ("está livre do alistamento por enquanto!")
    }
    senao {escreva("Corra para se alistar pois ja é chegada a hora de servir ao exercito pintando meio fio")
    }



    
  }
}
