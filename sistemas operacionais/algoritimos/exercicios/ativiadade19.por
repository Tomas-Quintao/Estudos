programa {
 real nota1 , nota2, media
 cadeia nome


  funcao inicio() {
    escreva ("qual é o seu nome")
    leia (nome)
    escreva ("escreva a primeira nota")
    leia(nota1)
    escreva ("escreva a segunda nota")
    leia(nota2)
    media = nota1 + nota2 / 2 

    escreva (media)
    se (media >= 7 ){
      escreva (" você pasou")

    }
    senao {
      escreva (" você não passou")
    }

    

    




    
  }
}
