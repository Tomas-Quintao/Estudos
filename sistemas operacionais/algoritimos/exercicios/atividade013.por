programa {
 real salario, salariofinal,salarioa
 

  funcao inicio() {
    escreva("escreva o valor do seu salario:")
    leia(salario)
    salarioa = salario * 0.15 
    salariofinal = salarioa + salario
    escreva("o seu salario com aumento de 15% é de ",
    salariofinal," reais")



    
  }
}
